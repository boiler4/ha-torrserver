{
  "entity": {
    "sensor": {
      "stream_health": {
        "default": "mdi:traffic-light",
        "state": {
          "idle": "mdi:minus-circle-outline",
          "critical": "mdi:alert-circle",
          "warning": "mdi:alert",
          "healthy": "mdi:check-circle",
          "measuring": "mdi:timer-sand",
          "unknown": "mdi:help-circle-outline"
        }
      }
    }
  }
}
